{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Mark", "version": "0.2.0", "identifier": "com.markapp.Mark",
  "build": {
    "frontendDist": "../dist", "devUrl": "http://127.0.0.1:1420",
    "beforeDevCommand": "pnpm dev", "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [{
      "label": "editor", "title": "Mark", "width": 800, "height": 580,
      "minWidth": 380, "minHeight": 280, "visible": false, "center": true,
      "resizable": true, "alwaysOnTop": true, "skipTaskbar": true,
      "titleBarStyle": "Overlay", "hiddenTitle": true, "dragDropEnabled": false,
      "transparent": true,
      "windowEffects": {
        "effects": ["underWindowBackground"],
        "state": "followsWindowActiveState",
        "radius": 12
      }
    }],
    "security": {
      "capabilities": ["editor", "selector"],
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'; base-uri 'self'",
      "devCsp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost http://127.0.0.1:1420 ws://127.0.0.1:1420; object-src 'none'; frame-src 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "active": true, "targets": ["app"], "category": "Utility",
    "shortDescription": "Capture a region. Copy and close.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns"],
    "macOS": { "minimumSystemVersion": "13.0", "signingIdentity": "Apple Development: tmass1@me.com (7H35QWWLTC)", "infoPlist": "Info.plist" }
  }
}
