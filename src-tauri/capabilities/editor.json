{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "editor",
  "description": "Only Mark's local editor can capture, annotate, copy, save and share.",
  "windows": ["editor"], "platforms": ["macOS"],
  "permissions": [
    "allow-current-capture", "allow-capture-region", "allow-capture-display",
    "allow-copy-capture", "allow-copy-edited", "allow-save-image", "allow-share-image",
    "allow-dismiss-editor", "allow-open-screen-settings", "allow-quit-app",
    "core:window:allow-start-dragging", "core:window:allow-internal-toggle-maximize",
    "core:event:allow-listen", "core:event:allow-unlisten"
  ]
}
