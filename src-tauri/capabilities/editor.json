{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "editor",
  "description": "Only Mark's local editor can capture, copy, drag, and remember its size.",
  "windows": ["editor"], "platforms": ["macOS"],
  "permissions": [
    "allow-current-capture", "allow-capture-region", "allow-copy-and-close",
    "allow-copy-annotated-and-close",
    "allow-dismiss-editor", "allow-open-screen-settings",
    "core:window:allow-start-dragging", "core:window:allow-internal-toggle-maximize",
    "core:window:allow-inner-size", "core:window:allow-scale-factor", "core:window:allow-set-size",
    "core:event:allow-listen", "core:event:allow-unlisten",
    "store:allow-load", "store:allow-get-store", "store:allow-get", "store:allow-set", "store:allow-save"
  ]
}
