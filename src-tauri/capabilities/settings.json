{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "settings",
  "description": "The settings window may read and change the preferences, ask whether this Mac can record, copy the lines that point an AI tool at Mark or open the link that adds it or the guide to it, ask for an update check, and close itself.",
  "windows": ["settings"], "platforms": ["macOS"],
  "permissions": [
    "allow-get-settings", "allow-set-appearance", "allow-set-shortcut", "allow-set-after-capture", "allow-set-mcp", "allow-set-record-options", "allow-recording-supported", "allow-mcp-setup", "allow-add-to-agent", "allow-open-guide", "allow-copy-text",
    "allow-login-enabled", "allow-set-login", "allow-set-auto-update", "allow-open-updates",
    "core:window:allow-close", "core:window:allow-inner-size", "core:window:allow-scale-factor", "core:window:allow-set-size", "core:app:allow-version"
  ]
}
