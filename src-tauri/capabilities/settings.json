{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "settings",
  "description": "The settings window may read and change the preferences, ask for an update check, and close itself.",
  "windows": ["settings"], "platforms": ["macOS"],
  "permissions": [
    "allow-get-settings", "allow-set-appearance", "allow-set-shortcut",
    "allow-login-enabled", "allow-set-login", "allow-set-auto-update", "allow-open-updates",
    "core:window:allow-close", "core:window:allow-set-size", "core:app:allow-version"
  ]
}
